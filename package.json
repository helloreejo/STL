{
  "name": "santotech-labs-website",
  "version": "0.1.0",
  "private": true,
  "description": "SantoTech Labs marketing website \u2014 HTML5 + Tailwind CSS",
  "scripts": {
    "dev": "npm-run-all --parallel watch:css watch:js serve",
    "watch:css": "tailwindcss -i ./src/css/input.css -o ./dist/app.css --watch",
    "watch:js": "esbuild src/js/script.js --bundle --format=iife --target=es2019 --sourcemap --outfile=dist/app.js --watch",
    "build": "npm-run-all build:css build:js",
    "build:css": "tailwindcss -i ./src/css/input.css -o ./dist/app.css --minify",
    "build:js": "esbuild src/js/script.js --bundle --format=iife --target=es2019 --minify --outfile=dist/app.js",
    "serve": "http-server . -p 5173 -c-1 -o"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.3"
  }
}
