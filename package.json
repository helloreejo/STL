{
  "name": "santotech-labs-website",
  "version": "0.1.0",
  "private": true,
  "description": "SantoTech Labs marketing website — HTML5 + Tailwind CSS",
  "scripts": {
    "dev": "npm-run-all --parallel watch:css serve",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/output.css --watch",
    "build": "tailwindcss -i ./css/input.css -o ./css/output.css --minify",
    "serve": "http-server . -p 5173 -c-1 -o"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "http-server": "^14.1.1",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.3"
  }
}
